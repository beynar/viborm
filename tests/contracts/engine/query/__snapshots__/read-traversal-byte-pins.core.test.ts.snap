// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`polymorphic collection read SQL > PostgreSQL collection _count projection and ordering 1`] = `
{
  "params": [
    "items",
  ],
  "sql": "SELECT "t0"."id" AS "id", json_build_object($1::text, ((SELECT COUNT(*) FROM "gallery_items_article" AS "t1" WHERE "t1"."galleryId" = "t0"."id") + (SELECT COUNT(*) FROM "gallery_items_clip" AS "t3" WHERE "t3"."galleryId" = "t0"."id"))) AS "0viborm_relation_counts" FROM "gallery" AS "t0"",
}
`;

exports[`polymorphic collection read SQL > PostgreSQL collection _count projection and ordering 2`] = `
{
  "params": [],
  "sql": "SELECT "t0"."id" AS "id", "t0"."name" AS "name" FROM "gallery" AS "t0" ORDER BY ((SELECT COUNT(*) FROM "gallery_items_article" AS "t1" WHERE "t1"."galleryId" = "t0"."id") + (SELECT COUNT(*) FROM "gallery_items_clip" AS "t3" WHERE "t3"."galleryId" = "t0"."id")) DESC",
}
`;

exports[`polymorphic collection read SQL > PostgreSQL collection quantifier filters 1`] = `
{
  "params": [
    "x",
  ],
  "sql": "SELECT "t0"."id" AS "id", "t0"."name" AS "name" FROM "gallery" AS "t0" WHERE EXISTS (SELECT 1 FROM "gallery_items_article" AS "t1", "article" AS "t2" WHERE ("t1"."galleryId" = "t0"."id" AND "t2"."id" = "t1"."articleId" AND "t2"."title" = $1))",
}
`;

exports[`polymorphic collection read SQL > PostgreSQL collection quantifier filters 2`] = `
{
  "params": [
    "x",
  ],
  "sql": "SELECT "t0"."id" AS "id", "t0"."name" AS "name" FROM "gallery" AS "t0" WHERE (NOT EXISTS (SELECT 1 FROM "gallery_items_article" AS "t1" LEFT JOIN "article" AS "t2" ON "t2"."id" = "t1"."articleId" WHERE ("t1"."galleryId" = "t0"."id" AND ("t2"."id" IS NULL OR NOT ("t2"."title" = $1)))) AND NOT EXISTS (SELECT 1 FROM "gallery_items_clip" AS "t3" WHERE "t3"."galleryId" = "t0"."id"))",
}
`;

exports[`polymorphic collection read SQL > PostgreSQL direct collection include narrowed by only 1`] = `
{
  "params": [
    "__viborm_state",
    "collection",
    "arms",
    "article",
    "membership",
    "orphans",
    "rows",
    "__viborm_state",
    "linked",
    "type",
    "article",
    "data",
    "id",
    "title",
    2,
    "clip",
    "membership",
    "orphans",
    "rows",
  ],
  "sql": "SELECT "t0"."id" AS "id", "t0"."name" AS "name", json_build_object($1::text, CAST($2 AS TEXT), $3::text, json_build_object($4::text, json_build_object($5::text, (SELECT COUNT(*) FROM "gallery_items_article" AS "t1" WHERE "t1"."galleryId" = "t0"."id"), $6::text, (SELECT COUNT(*) FROM "gallery_items_article" AS "t1" LEFT JOIN "article" AS "t2" ON "t2"."id" = "t1"."articleId" WHERE ("t1"."galleryId" = "t0"."id" AND "t2"."id" IS NULL)), $7::text, (SELECT COALESCE(json_agg("t3"."_json"), '[]'::json) FROM (SELECT json_build_object($8::text, CAST($9 AS TEXT), $10::text, CAST($11 AS TEXT), $12::text, json_build_object($13::text, "t2"."id", $14::text, "t2"."title")) AS "_json" FROM "gallery_items_article" AS "t1", "article" AS "t2" WHERE ("t1"."galleryId" = "t0"."id" AND "t2"."id" = "t1"."articleId") ORDER BY "t2"."title" ASC, "t2"."id" ASC LIMIT $15) "t3")), $16::text, json_build_object($17::text, (SELECT COUNT(*) FROM "gallery_items_clip" AS "t4" WHERE "t4"."galleryId" = "t0"."id"), $18::text, (SELECT COUNT(*) FROM "gallery_items_clip" AS "t4" LEFT JOIN "clip" AS "t5" ON "t5"."id" = "t4"."clipId" WHERE ("t4"."galleryId" = "t0"."id" AND "t5"."id" IS NULL)), $19::text, NULL))) AS "items" FROM "gallery" AS "t0"",
}
`;

