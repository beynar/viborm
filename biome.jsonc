{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noAssignInExpressions": "off",
        "useGuardForIn": "off",
        "useAwait": "off",
        "noThenProperty": "off",
        "noConfusingVoidType": "off"
      },
      "style": {
        "noNamespace": "off",
        "useConsistentTypeDefinitions": "off",
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "noNestedTernary": "off",
        "noEnum": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "off",
          "options": {
            "maxAllowedComplexity": 45
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "info"
      }
    }
  },
  "overrides": [
    {
      // Blume page overrides use PascalCase component names, and Biome does not
      // connect Astro frontmatter imports to their template references.
      "includes": ["docs/**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          },
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
