---
import Icon from "blume/components/Icon.astro";

const databases = [
  {
    description: "pg, postgres.js, Neon HTTP, PGlite, and Bun SQL",
    icon: "database",
    name: "PostgreSQL",
  },
  {
    description: "mysql2, PlanetScale, and Bun SQL",
    icon: "server",
    name: "MySQL",
  },
  {
    description: "sqlite3, libSQL, Bun SQLite, and Cloudflare D1",
    icon: "hard-drive",
    name: "SQLite",
  },
];
---

<section class="grid items-center gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
  <div>
    <p class="font-medium text-accent text-sm">Adapter-owned SQL</p>
    <h2 class="mt-3 text-balance font-medium text-3xl tracking-tight sm:text-4xl">
      Write the query once. Choose the database at the edge.
    </h2>
    <p class="mt-5 max-w-xl text-muted-foreground leading-relaxed">
      VibORM keeps query intent separate from dialect syntax. You keep the same
      model and client API while the adapter handles the SQL each database needs.
    </p>
    <a
      class="mt-7 inline-flex items-center gap-2 font-medium text-sm transition-colors hover:text-accent"
      href="/docs/drivers"
    >
      Explore every driver
      <Icon name="arrow-right" size={15} />
    </a>
  </div>

  <div class="grid gap-3">
    {
      databases.map((database) => (
        <article class="flex items-center gap-4 rounded-blume border border-border bg-background p-5 shadow-sm shadow-foreground/[0.02]">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-blume bg-muted text-accent">
            <Icon name={database.icon} size={20} />
          </span>
          <div class="min-w-0">
            <h3 class="font-medium">{database.name}</h3>
            <p class="mt-1 text-muted-foreground text-sm">{database.description}</p>
          </div>
          <Icon class="ml-auto shrink-0 text-muted-foreground" name="circle-check" size={18} />
        </article>
      ))
    }
  </div>
</section>
