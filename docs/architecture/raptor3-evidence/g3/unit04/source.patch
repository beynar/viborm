+        g3_native_bulk_records: `${identity},${names.quote("code")} ${textType} NOT NULL UNIQUE,${names.quote("label")} ${textType} NOT NULL,${names.quote("secret")} ${textType} NOT NULL,${names.quote("score")} INTEGER NOT NULL`,
