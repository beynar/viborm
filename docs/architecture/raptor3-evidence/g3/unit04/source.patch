+      assert(candidateFactory);
+      const client = createClient({ schema, driver });
+      const candidate = candidateFactory({ schema, driver });
+      const series = scopedOperation(
+        client.post.findMany(),
+        candidate,
+        "createMany",
+        {
+          data: [
+            {
+              id: "prefix",
+              title: "prefix",
+              author: { create: { id: "ap", name: "prefix" } },
