-export function canGenerate(
-  schema: AnySchema,
-  seen: Set<AnySchema> = new Set()
-): boolean {
-  if (seen.has(schema)) return true;
-  seen.add(schema);
-  const node = classify(schema);
-  switch (node.kind) {
-    case "scalar":
-    case "object":
