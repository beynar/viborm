-  const buildRow = (
-    row: Record<string, unknown>,
-    initialResult?: Record<string, unknown>
-  ): Record<string, unknown> => {
-    const result: Record<string, unknown> = initialResult ?? {};
-    const keyRow: Record<string, unknown> | undefined = rowKeys
-      ? {}
-      : undefined;
-    for (let i = 0; i < len; i++) {
