-    return ctx.adapter.json.objectFromColumns(
-      castNumericPairsForJson(ctx, pairs)
-    );
-  }
-  return sql.join(
-    pairs.map(([name, expr]) => ctx.adapter.identifiers.aliased(expr, name)),
-    ", "
