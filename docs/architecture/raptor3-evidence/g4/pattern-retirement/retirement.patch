-  const innerQuery = assembleInnerQuery(adapter, {
-    selectExpr: adapter.identifiers.aliased(linked, jsonColAlias),
-    from: traversal.from(),
-    joins: window.joins,
-    where: window.where,
-    orderBy: window.orderBy,
-    take: window.limit,
-    skip: window.offset,
-    distinct: window.distinct,
-    distinctColumnAliases: [jsonColAlias],
