-    if (entry.column === undefined) {
-      byKind.set(name, true);
-      continue;
-    }
-    const current = byKind.get(name);
-    const fields = Array.isArray(current) ? current : [];
-    fields.push(entry.column);
-    byKind.set(name, fields);
-  }
