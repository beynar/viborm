-function selectArm(
-  arms: readonly MemberArm[],
-  publicType: string,
-  field: string
-): MemberArm {
-  const arm = arms.find((candidate) => candidate.publicType === publicType);
-  if (!arm) {
-    throw new QueryEngineError(
-      `Unknown polymorphic target '${publicType}' for relation '${field}'.`
-    );
-  }
-  return arm;
-}
