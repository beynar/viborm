-          model,
-          key,
-          relation,
-          value,
-          operation,
-          expected.shape
-        );
-      };
-      continue;
-    }
-
-    if (column.kind === "aggregate") {
-      allIdentity = false;
-      mayReuseContainer = false;
-      steps[i] = (result, value) => {
