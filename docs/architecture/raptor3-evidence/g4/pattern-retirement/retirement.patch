-    [
-      {
-        matches: [],
-        writes: [root],
-        premises: [],
-        inherited: [],
-        boundary: { kind: "mergeOutcome", row: 0 },
-      },
-      {
-        matches: [],
-        writes: [child],
-        premises: [],
-        inherited: [],
-        // A dependent of the merge root; the group runs on to the next
-        // member/end boundary.
-        boundary: {
-          kind: "executionBinding",
-          variable: 0,
-          statement: "post.create",
