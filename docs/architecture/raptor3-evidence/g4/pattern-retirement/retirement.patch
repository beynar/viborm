-  if (conditions.length === 0) {
-    return undefined;
-  }
-
-  return ctx.adapter.operators.and(...conditions);
-}
-
-const buildNestedWhere: BuildNestedWhere = (
-  ctx,
-  where,
-  positivePolarity = true
-) => buildWhereAtPolarity(ctx, where, ctx.rootAlias, positivePolarity);
