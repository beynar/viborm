-  const delimiter = body.indexOf(",", start);
-  const next = delimiter === -1 ? body.length : delimiter;
-  const raw = body.slice(start, next);
-  if (raw.length === 0) return undefined;
-  return { value: raw === "NULL" ? null : raw, next };
