-      const relationCondition = buildRelationFilter(
-        ctx,
-        relationRef,
-        value as Record<string, unknown>,
-        alias,
-        positivePolarity
-      );
-      if (relationCondition) {
-        conditions.push(relationCondition);
-      }
-      continue;
-    }
