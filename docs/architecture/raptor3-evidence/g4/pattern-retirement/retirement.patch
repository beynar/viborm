-    sql.join(
-      [
-        adapter.clauses.select(adapter.aggregates.count()),
-        adapter.clauses.from(traversal.from()),
-        adapter.clauses.where(adapter.operators.and(...conditions)),
-      ],
-      " "
-    )
-  );
-}
