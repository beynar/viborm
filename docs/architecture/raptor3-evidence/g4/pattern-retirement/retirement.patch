-  // ---- references --------------------------------------------------------
-
-  private targetModel(cells: ReferenceCells): Model<any> {
-    if (cells.viaJunction) return cells.referenced.model;
-    return cells.holderIsSource ? cells.referenced.model : cells.holder.model;
-  }
