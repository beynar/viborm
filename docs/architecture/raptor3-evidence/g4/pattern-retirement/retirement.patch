-function prepareBatchQuery(
-  statement: Sql,
-  driver: AnyDriver,
-  context: QueryExecutionContext
-): PreparedQuery {
-  const prepared = driver._prepare(statement, context);
-  return transferPreparedStatement(prepared, {
-    sql: prepared.sql,
-    params: prepared.params ?? [],
-    context,
-  });
