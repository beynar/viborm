-  private projectionFrom(
-    model: Model<any>,
-    select: unknown,
-    include: unknown,
-    row: RowDraft
-  ): Projection | undefined {
-    const scalarNames = model["~"].scalarFieldNames as readonly string[];
-    const relations = model["~"].state.relations as Record<string, unknown>;
