-    const window =
-      typeof limit === "number" ? { orderBy: [], take: limit } : undefined;
-    if (
-      scalars.length === 0 &&
-      projected.length === 0 &&
-      counts.length === 0 &&
-      !window
-    ) {
-      return undefined;
