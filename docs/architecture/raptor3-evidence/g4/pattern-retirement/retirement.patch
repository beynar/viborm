-    id: "user.create",
-    kind: "write",
-    model: "user",
-    statement: sql`INSERT INTO "sim_users" ("id") VALUES (${"u9"}) ON CONFLICT DO NOTHING`,
-    outputs: { count: { kind: "rowCount" } },
