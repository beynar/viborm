-  if (Array.isArray(value)) {
-    for (const byte of value) {
-      if (!Number.isInteger(byte) || byte < 0 || byte > 255) {
-        return unsupportedBlobValue(provider, operation, "byte array");
-      }
-    }
-    return Uint8Array.from(value);
-  }
