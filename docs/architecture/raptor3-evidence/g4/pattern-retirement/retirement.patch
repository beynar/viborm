-      holder: row.id,
-      referenced: parent.id,
-      columns: toParent,
-      onKeyChange: cells.onKeyChange,
-      nullable: false,
-      unique: false,
-      relation: cells.relation,
-      ...(arm === undefined ? {} : { arm }),
-    });
-    for (const pair of toParent) {
-      this.cell(
-        row,
-        pair.holderColumn,
-        this.keyVariable(parent, pair.referencedColumn),
-        cellMode,
-        arm
-      );
-    }
-    if (target) {
-      this.references.push({
-        holder: row.id,
-        referenced: target.id,
-        columns: cells.cells,
-        onKeyChange: cells.onKeyChange,
-        nullable: false,
-        unique: cells.unique,
-        relation: cells.relation,
-        ...(arm === undefined ? {} : { arm }),
-      });
-      for (const pair of cells.cells) {
-        this.cell(
-          row,
-          pair.holderColumn,
-          this.keyVariable(target, pair.referencedColumn),
-          cellMode,
-          arm
-        );
-      }
-    }
