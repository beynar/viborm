-export function getFilterPredicateFields(
-  model: Model<any>,
-  filter: unknown
-): PredicateFieldSet {
-  const fields = new Set<string>();
-  return collectFilterPredicateFields(model, filter, fields)
-    ? fields
-    : "unknown";
-}
