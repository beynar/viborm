-    id: "post.create",
-    kind: "write",
-    model: "post",
-    statement: sql`INSERT INTO "sim_posts" ("id", "author_id") VALUES (${"p9"}, ${"u9"})`,
-    outputs: { count: { kind: "rowCount" } },
