-      type,
-      options: scalarOptions(Reflect.get(schema, "options")),
-      values: Array.isArray(values) ? values : [],
-      value: Reflect.get(schema, "value"),
-      dimensions: typeof dimensions === "number" ? dimensions : undefined,
