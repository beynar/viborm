-    // Handle scalar filters
-    if (isScalarField(ctx.model, key)) {
-      const scalarCondition = buildScalarFilter(
-        ctx,
-        key,
-        value,
-        alias,
-        positivePolarity
-      );
-      if (scalarCondition) {
-        conditions.push(scalarCondition);
-      }
-      continue;
-    }
