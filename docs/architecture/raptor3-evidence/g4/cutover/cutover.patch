-/** A self-referential pair with explicit columns on ONE side. */
-const selfSchema = (() => {
-  const follower: Model<any> = s.model({
-    id: s.string().id(),
-    follows: s
-      .toMany(() => follower)
-      .source("followerId")
-      .target("followedId"),
