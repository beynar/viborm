-      case "aggregate":
-        return buildAggregate(ctx, args);
-      case "groupBy": {
-        const by = args.by;
-        if (typeof by !== "string" && !Array.isArray(by)) {
-          throw new QueryEngineError(
-            "query-engine-v2 groupBy is missing a valid by value."
-          );
-        }
-        return buildGroupBy(ctx, { ...args, by });
-      }
-    }
-  }
-}
-
