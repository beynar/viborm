-  /** Nested `createMany`: FK-injected rows spliced after the parent (one INSERT). */
-  private foldCreateMany(
-    input: Parameters<CreateOperation["interpretRelation"]>[0],
-    childScope: QueryScope,
-    relation: ChildHeldRelation,
