-function fragmentContract(
-  driver: AnyDriver,
-  fragment: PlanningFragment | OperationFragment
-): unknown {
-  return {
-    steps: fragment.steps.map((current) => stepContract(driver, current)),
-    outputs: normalized(publishedOutputs(fragment)),
-  };
-}
