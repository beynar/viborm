-// `"t0"."id" COLLATE BINARY IN (?, ?)`).
-const EQUALITY =
-  /(?:"([^"]+)"|`([^`]+)`)(?:\s+COLLATE\s+\w+)?\s*=\s*\(*\s*(?:CAST\(\s*)?(\$\d+|\?)/g;
