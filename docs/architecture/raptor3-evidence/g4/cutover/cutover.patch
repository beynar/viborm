-async function runArm(
-  family: PGliteSchemaFamily<typeof updateSliceSchema>,
-  kind: ArmKind,
-  scenario: Scenario
-) {
-  await family.reset();
-  const client = makeClient(family.database, family.namespace);
-  await scenario.seed(client);
-
-  let result: unknown;
-  let error: ErrorShape | undefined;
-  try {
-    if (kind === "v1") {
-      result = await client.user.update(scenario.args as never);
-    } else {
-      const driver =
-        kind === "v2-tx"
-          ? new PGliteDriver({
-              client: family.database,
-              namespace: family.namespace,
-            })
