-      operationInstance,
-      createOperationExecutionContext(
-        modelName,
-        operation,
-        engine.instrumentation
-      )
-    );
-  };
-  /** `{ count }` arm — no `select` in the payload. */
-  const bulkCount = (
-    modelName: BulkModel,
-    kind: "updateMany" | "deleteMany",
-    args: Record<string, unknown>
