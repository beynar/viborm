-    scope.kind === "junction"
-      ? scope.sourceIsFirst
-      : relation.position === "parentHeld";
-  return currentIsFirst
-    ? { first: currentConstraint, second: targetConstraint }
-    : { first: targetConstraint, second: currentConstraint };
-}
