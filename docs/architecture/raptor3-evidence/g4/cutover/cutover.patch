-    if (update.kind === "none" || update.compiler.targetReadId !== probeId) {
-      return {
-        select: targetProjectionRowKeySelect(
-          buildTargetProjection(this.childScope.model)
-        ),
-        additionalColumns: [],
-        outputs: { rows: { kind: "rows" } },
