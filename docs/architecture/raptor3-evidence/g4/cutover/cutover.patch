-        kind: "connectOrCreate",
-        relationRef: input.edge.ref,
-        probeId,
-        guardId,
-        guard: {
-          kind: "captured",
-          fields: [guardField],
-          where: spec.where,
-          forUpdate: false,
-        },
-        before,
-        foundAssignment: {
-          kind: "polymorphic",
-          storage: linkedPolymorphicStorage(
-            directPolymorphicMembership(input.edge),
-            {
-              kind: "planningField",
-              step: probeId,
-            }
-          ),
-        },
-        missingAssignment: {
-          kind: "polymorphic",
-          storage: linkedPolymorphicStorage(
-            directPolymorphicMembership(input.edge),
-            missingSource
