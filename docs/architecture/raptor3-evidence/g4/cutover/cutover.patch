-    if (target.constraintKey) {
-      if (exact.has(target.constraintKey)) continue;
-      exact.add(target.constraintKey);
-    } else if (
-      unique.some(
-        (candidate) =>
-          classifyTargetConstraintOverlap(
-            target.constraint,
-            candidate.constraint
-          ) === "equal"
-      )
-    ) {
-      continue;
-    }
-    unique.push(target);
-  }
-  return unique;
