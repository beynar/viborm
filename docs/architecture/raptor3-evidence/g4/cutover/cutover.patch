-      );
-    },
-    async create(modelName, model, args) {
-      return await executor.execute(
-        new CreateOperation(engine, model, args),
-        createOperationExecutionContext(
-          modelName,
-          "create",
-          engine.instrumentation
-        )
-      );
-    },
-  };
-}
