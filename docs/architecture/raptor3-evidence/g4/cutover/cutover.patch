-  return (
-    operation === "findUnique" ||
-    operation === "findFirst" ||
-    operation === "findMany" ||
-    operation === "count" ||
-    operation === "aggregate" ||
-    operation === "groupBy" ||
-    operation === "exist"
-  );
-}
-
-function requireFindUniqueArgs(args: Record<string, unknown>): {
-  where: Record<string, unknown>;
-  select?: Record<string, unknown>;
-  include?: Record<string, unknown>;
