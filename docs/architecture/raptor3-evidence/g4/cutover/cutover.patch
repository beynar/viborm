-    (row): row is Record<string, unknown> =>
-      isRecord(row) &&
-      classifyTargetConstraintOverlap(
-        target.constraint,
-        normalizeTargetConstraint(target.edge.member.targetModel, fields, row)
-      ) === "equal"
-  );
-}
