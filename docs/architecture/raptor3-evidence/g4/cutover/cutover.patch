-  // captured, depth adding list entries and one parent-id value.
-  const deeperBuilder: JunctionTargetRelationsBuilder = (
-    deeperScope,
-    deeperParentId,
-    deeperRelations,
-    deeperTxMode,
-    deeperCorrelationParentId
