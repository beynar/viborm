-        .name("badges"),
-    })
-    .map("n4pi_badges");
-
-  return {
-    org,
-    team,
-    task,
-    sub,
-    owner,
-    label,
-    lead,
-    squad,
-    drill,
-    account,
-    profile,
-    badge,
-  };
-})();
