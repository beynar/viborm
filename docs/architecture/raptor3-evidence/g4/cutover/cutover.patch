-      id,
-      kind: "write",
-      model: getStepModelName(this.childScope.model, "record"),
-      statement,
-      outputs: generatedField
-        ? {
-            id: capturesByReturning
-              ? { kind: "firstRowField", field: generatedField }
-              : { kind: "insertId" },
