-  const driver = new SQLite3Driver({ client: database });
-  const config = { driver, schema };
-  const base = (
-    route === "shipped" ? createClient(config) : createCandidateClient(config)
-  ) as VibORMClient<{ driver: SQLite3Driver; schema: typeof schema }>;
