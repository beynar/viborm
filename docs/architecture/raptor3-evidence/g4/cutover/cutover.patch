-  constructor(
-    options: ConstructorParameters<typeof PGliteDriver>[0],
-    config: {
-      table: string;
-      column: string;
-      mode: "wrong" | "drop";
-      wrongValue?: unknown;
-    }
-  ) {
-    super(options);
-    this.table = config.table;
-    this.column = config.column;
-    this.mode = config.mode;
-    this.wrongValue = config.wrongValue;
-  }
