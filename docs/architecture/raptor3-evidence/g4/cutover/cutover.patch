-interface SegmentObservation {
-  readonly unit: Readonly<{
-    kind: string;
-    model?: string;
-    operation?: string;
-  }>;
-  readonly completion: Promise<
-    Readonly<{
-      status: "success" | "failure";
-      commitCertainty?: "committed" | "may-have-committed";
-    }>
-  >;
-  summary?: Readonly<{
-    status: "success" | "failure";
-    commitCertainty?: "committed" | "may-have-committed";
