-          const rawUpdate = requireRecord(
-            item.update?.parsed,
-            `${relationName}.upsert.update`
-          );
-          return {
-            parsed: rawUpdate,
-            source: item.update?.source,
-          } satisfies RecordMutationData;
-        })();
