-  return new UpdateOperation(
-    engineFor(driver),
-    parityHSchema.hub as Model<any>,
-    { where: { id: "h1" }, data, select: { id: true } }
-  );
-}
-
-function hubCreateOperation(
-  driver: AnyDriver,
-  data: Record<string, unknown>
