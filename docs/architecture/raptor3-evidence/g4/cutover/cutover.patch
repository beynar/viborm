-        id: probeId,
-        kind: "read",
-        model: getStepModelName(childScope.model, "record"),
-        statement: buildFindUnique(childScope, {
-          where: spec.where,
-          select,
-          forUpdate: input.txMode,
-        }),
-        outputs: { rows: { kind: "rows" } },
-      };
