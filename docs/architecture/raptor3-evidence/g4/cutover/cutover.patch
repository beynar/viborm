-        ? buildCreate(childScope, {
-            data: insertData,
-            polymorphicStorage,
-            select,
-          })
-        : buildInsert(
-            childScope,
-            getTableName(childScope.model),
-            insertData,
-            polymorphicStorage
-          );
-    if (!statement) {
-      throw new QueryEngineError(
-        `query-engine-v2 create did not build the root skip statement '${writeStepId}'.`
-      );
-    }
