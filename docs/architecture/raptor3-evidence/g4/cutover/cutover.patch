-interface ToOneUpdateFootprint {
-  readonly readConstraint: TargetConstraint;
-  readonly changedFields: ReadonlySet<string>;
-  readonly resultConstraints: readonly TargetConstraint[];
-  readonly writesMembership: boolean;
