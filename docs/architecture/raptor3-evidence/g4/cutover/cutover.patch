-      model,
-      childScope,
-      scalarData,
-      relationSuppliedValues: sharedPk.suppliedValues,
-      explicitScalarFields,
-      ...(postWriteLocator ? { postWriteLocator } : {}),
-      databaseAssigned,
-      identity,
-      writeStepId,
-      parentHeldArms,
-      childCreates,
-      createManyWork,
-      afterParts,
