-      where: { id: "folder-1" },
-      data: {
-        cards: {
-          updateMany: {
-            where: {},
-            data: {
-              subject: {
-                update: { type: "article", data: { title: "updated" } },
-              },
-            },
-          },
-        },
-      },
-      select: { id: true },
