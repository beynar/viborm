-// =============================================================================
-// THE PROJECTION ROUND TRIP
-// =============================================================================
-
-const SEED = Number(process.env.PATTERN_FUZZ_SEED ?? 20_240_902);
-const COUNT = Number(process.env.PATTERN_WRITE_RESULT_COUNT ?? 200);
-
-const READ_WEIGHTS: Readonly<Record<RootOperation, number>> = {
-  findMany: 3,
-  findFirst: 1,
-  findUnique: 1,
-  count: 0,
-  aggregate: 0,
-  groupBy: 0,
-  create: 0,
-  update: 0,
-  upsert: 0,
-  delete: 0,
-  createMany: 0,
-  updateMany: 0,
-  deleteMany: 0,
