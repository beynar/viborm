-          childScope,
-          {
-            data: [insertData],
-            skipDuplicates: true,
-            ...(Object.keys(select).length > 0 ? { select } : {}),
-          },
-          Object.keys(select).length > 0,
-          [polymorphicStorage],
-          this.engine.maxBindParametersPerStatement
-        ).statements[0]?.sql
