+/** The one comparison this file reads: how `<column> =` is spelled for `id`. */
+function keyComparisons(sql: string): string[] {
+  return [...sql.matchAll(KEY_COMPARISON)].map((match) =>
+    match[1] ? "exact" : "constraint"
+  );
