+    const envelopeOf = ({
+      create: _create,
+      update: _update,
+      ...envelope
+    }: Record<string, unknown>) => envelope;
+    assert.deepEqual(
+      observations.candidate.seen.map(envelopeOf),
+      observations.shipped.seen.map(envelopeOf)
