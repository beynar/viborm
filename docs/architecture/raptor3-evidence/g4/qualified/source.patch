+  it("still pages a direct scalar order beside a cursor on both engines", async () => {
+    const seen = await outcomes(seedPosts, "post", "findMany", {
+      orderBy: { id: "asc" },
+      cursor: { id: 1 },
+      take: 2,
+      select: { id: true },
+    });
