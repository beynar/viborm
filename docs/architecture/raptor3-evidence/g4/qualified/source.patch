+                },
+              },
+            }),
+        ],
+        [
+          "nested set, COMPOUND selector, collation-equal members",
+          (call) =>
+            call("owner", "update", {
+              where: { id: "wanted" },
+              data: {
+                parts: {
+                  set: [{ region_slug: { region: "EU", slug: "ALPHA" } }],
+                },
+              },
+            }),
+        ],
+        [
+          "junction connect on a collation-equal key",
+          (call) =>
+            call("owner", "update", {
+              where: { id: "wanted" },
+              data: { tags: { connect: [{ id: "G1" }] } },
