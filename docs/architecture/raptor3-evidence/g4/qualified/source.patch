+const KEY_COMPARISON = /"id"(\s+COLLATE\s+BINARY)?\s*=/gi;
+const FILTER_SPELLING = /"name"\s+COLLATE\s+BINARY/i;
+const CASE_INSENSITIVE_COLLATION = /_ci$/;
