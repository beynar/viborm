+      {
+        label: "PRESENT target, arity NONE (`{}`) on the key",
+        model: "owner",
+        operation: "update",
+        args: {
+          where: { id: 1 },
+          data: {
+            items: {
+              upsert: [present(10, { id: 10, name: "i" }, { id: {} })],
+            },
+          },
+        },
+      },
+      {
+        label: "ABSENT target, arity NONE (`{}`) on the key",
+        model: "owner",
+        operation: "update",
+        args: {
+          where: { id: 1 },
+          data: {
+            items: {
+              upsert: [present(999, { id: 999, name: "fresh" }, { id: {} })],
