+            }),
+        ],
+        [
+          "junction disconnect, exact bytes (control)",
+          (call) =>
+            call("owner", "update", {
+              where: { id: "wanted" },
+              data: { tags: { disconnect: [{ id: "g1" }] } },
+            }),
+        ],
+        [
+          "junction delete on a collation-equal key",
+          (call) =>
+            call("owner", "update", {
+              where: { id: "wanted" },
+              data: { tags: { delete: [{ id: "G1" }] } },
+            }),
+        ],
+        [
+          "junction delete, exact bytes (control)",
+          (call) =>
+            call("owner", "update", {
+              where: { id: "wanted" },
