+    assert.equal(observations.candidate.batches, 1);
+  });
+
+  /**
+   * DIVERGENCE PIN D-5 (recorded, not chosen) — a MULTI-statement write as an
+   * array member on a BATCH-ONLY driver.
+   *
+   * The shipped route REFUSES it. `OperationExecutor.prepareSharedBatch`
+   * (`src/query-engine/write-engine/OperationExecutor.ts:1515`) rejects a plan
