== the two spellings, as they stand in the sources ==
--- shared/query.ts wholeValue (the owner, NEW) ---
export function wholeValue(
  value: unknown,
): { readonly value: unknown } | undefined {
  if (value instanceof Sql || value === null || typeof value !== "object")
    return { value };
  if (!isOperatorRecord(value)) return { value };
  return Object.hasOwn(value, "set")
    ? { value: record(value).set }
    : undefined;
}
--- commands/assignments.ts scalarAssignment (the consumer, NOW) ---
function scalarAssignment(value: unknown): unknown {
  const whole = wholeValue(value);
  return whole ? whole.value : value;
}
--- commands/assignments.ts scalarAssignment (the inline predicate, BEFORE, at 1e9b7c52) ---
function scalarAssignment(value: unknown): unknown {
  // An operator record states `set` as its OWN property. A `Uint8Array`
  // inherits `set` from its prototype and is one whole blob value, never an
  // operator record; the same holds for any class instance a codec owns.
  return value !== null &&
    typeof value === "object" &&
    !(value instanceof Sql) &&
    Object.hasOwn(value, "set")
    ? record(value).set
    : value;
}

