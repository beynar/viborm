if (
  process.argv[1] &&
  resolve(process.argv[1]) === fileURLToPath(import.meta.url)
) {
  try {
    await run(parseRaptor3Request(process.argv.slice(2)));
  } catch (failure) {
    process.stderr.write(
      `${failure instanceof Error ? failure.message : String(failure)}\\n`
    );
    process.exitCode = 1;
  }
}
