      \"g3-generated-smoke\": G3_GENERATED_SMOKE_COUNTS,
      \"g3-generated-transport-smoke\": G3_GENERATED_TRANSPORT_SMOKE_COUNTS,
      \"g3-generated-minimization\": G3_GENERATED_MINIMIZATION_COUNTS,
      \"g4-read-contracts\": G4_READ_COUNTS,
