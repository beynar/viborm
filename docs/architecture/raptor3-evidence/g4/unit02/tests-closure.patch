+       "ownerId" TEXT NOT NULL,
+       "tagId" TEXT NOT NULL,
+       PRIMARY KEY ("ownerId","tagId"),
+       FOREIGN KEY ("ownerId") REFERENCES "${SCOPE_OWNERS}" ("id"),
+       FOREIGN KEY ("tagId") REFERENCES "${SCOPE_TAGS}" ("id")
