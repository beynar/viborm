+      id: 12,
+      title: "third",
+      rank: 3,
+      authorId: 2,
+    });
+    assert.deepEqual(candidate, {
+      id: 11,
+      title: "second",
+      rank: 2,
+      authorId: 1,
+    });
+  });
+});
