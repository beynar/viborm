+import assert from "node:assert/strict";
+import type { BatchQuery, QueryExecutionContext, QueryResult } from "@drivers";
+import { SQLite3Driver } from "@drivers/sqlite3";
+import {
+  NestedWriteError,
+  NotFoundError,
